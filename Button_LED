#include <stdint.h>
#include <stm32f411xe.h>
#include <stm32f4xx.h>

volatile uint8_t button_flag = 0; // Fla variable to keep track of button presses

void init_gpio(void); // Function to initialize GPIO pins
void init_EXTI(void); // Function to initialize EXTI (External Interrupt)


int main(void)
{

    init_gpio();
    init_EXTI();
	while (1) {

        if(button_flag){
            GPIOA->ODR ^= GPIO_ODR_OD5; // Toggle the state of PA5
            button_flag = 0; // Reset the button flag
        }
    
    }
}

void init_gpio(void)
{

//CONFIGURACIÓN PIN A5
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN; // Enable GPIOA clock
    GPIOA->MODER &= ~GPIO_MODER_MODER5; // Clear mode bits for PA5
    GPIOA->MODER |= GPIO_MODER_MODER5_0; // Set PA5 as output
    GPIOA->OTYPER &= ~GPIO_OTYPER_OT_5; // Set PA5 as push-pull
    GPIOA->OSPEEDR &= ~GPIO_OSPEEDER_OSPEEDR5; // Clear speed bits for PA5
    GPIOA->OSPEEDR |= GPIO_OSPEEDER_OSPEEDR5_0; // Set PA5 to medium speed
    //CONFIGURACIÓN PIN C13
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN; // Enable GPIOC clock
    GPIOC->MODER &= ~GPIO_MODER_MODER13; // Clear mode bits for PC13 wich is the same as input
    GPIOC->PUPDR &= ~GPIO_PUPDR_PUPDR13; /* Set PC13 pull-up/pull-down to no pull no need for this 
    the button is already pulled up by the board
    */
}

void init_EXTI(void)
{
    // Enable SYSCFG clock
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN; // Enable SYSCFG clock
    SYSCFG->EXTICR[3] &= ~SYSCFG_EXTICR4_EXTI13; // Clear EXTI13 bits IT STARTS IN 0 SO 4 HAS THE 3TH POSITION
    //aditional, this mask has an FUL wich is an F(1111) and unsinged long
    SYSCFG->EXTICR[3] |= SYSCFG_EXTICR4_EXTI13_PC; // Set EXTI13 to PC13
    EXTI->RTSR &= ~EXTI_RTSR_TR13; //  diable rising edge trigger for EXTI13
    EXTI->FTSR |= EXTI_FTSR_TR13; // Enable falling edge trigger for EXTI13
    EXTI->IMR |= EXTI_IMR_MR13; // Unmask EX to allow interrupt for EXTI13
    EXTI->PR = EXTI_PR_PR13; // Clear pending interrupt for EXTI13 this bit is a rc_w1 wich means write
    // 1 to clear (this works only by writing) 
    /*
    !!SUPER IMPORTANTE, EN ESTE CASO DEBO ESCRIBIR UNA IGUALDAD, POR EL RC_W1, SI ESCRIBO UN OR O UN AND,
    PODRÍA LIMPIAR OTRAS INTERRUPCIONES, PERO AL ESCIRBIR CERO COMO NO HAGO NADA, SOLO OPERO EN EL BIT
    QUE NECESITO!!
    */
    /*
    1)LUEGO PROCEDEMOS A ACTIVAR LA INTERRUPCIÓN EN EL NVIC. DEBE SER LA LINEA QUE CONTINE LOS REGISTROS
        DEL 10 AL 15 REVISAR STARTUP
    2)LUEGO PARA ACTIVARLO CON CMSIS DEBO BUSCAR EL IRQn o IRQ NUMBER
    */
    NVIC_EnableIRQ(EXTI15_10_IRQn); // Enable EXTI line 10 to 15 interrupts in NVI
    
}

void EXTI15_10_IRQHandler(void){
    if(EXTI->PR & EXTI_PR_PR13){ // Check if the interrupt is from EXTI13 EXTI_PR SAVES IF THERE
        //IS ANY PENDING INTERRUPTION
        //THE I CONTRAST THE VALUE OF THE PENDING REGISTER WITH THE CMSIS MASK AND IF IT IS TRUE, THEN I
        //CLEAR THE PENDING INTERRUPT
        EXTI->PR = EXTI_PR_PR13; // Clear pending interrupt for EXTI13 LIMPIAMOS CON IGUALDAD POR EL RC_W1
        button_flag = 1; // Set the button flag
    }
}
