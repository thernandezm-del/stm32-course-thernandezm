#include <stdint.h>
#include <stm32f4xx.h>


int main(void)
{   
    init_gpio();

    //cargamos la funcion de inicializacion del timer 3
    init_tim3();
    
	while (1) {
       
}
}

void init_app(){
    RCC->AHB1ENR &= ~(RCC_AHB1ENR_GPIOAEN); //LIMPIANDO POSICIONES DE REGISTRO
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;

    //CONFIGURACION DE PINES A5
    GPIOA->MODER &= (0b11 << GPIO_MODER_MODE5_Pos); //LIMPIANDO POSICIONES DE REGISTRO
    GPIOA->MODER |= (0b01 << GPIO_MODER_MODE5_Pos); //CONFIGURANDO COMO SALIDA

    GPIOA->OTYPER &= ~GPIO_OTYPER_OT5; //CONFIGURANDO COMO PUSH-PULL
    
    GPIOA->OSPEEDR &= (0b11 << GPIO_OSPEEDR_OSPEED5_Pos); //LIMPIANDO POSICIONES DE REGISTRO
    GPIOA->OSPEEDR |= (0b01 << GPIO_OSPEEDR_OSPEED5_Pos); //CONFIGURANDO COMO ALTA VELOCIDAD

    GPIOA->PUPDR |= (0b11 << GPIO_PUPDR_PUPD5_Pos); //LIMPIANDO POSICIONES DE REGISTRO

    GPIOA->ODR |= GPIO_ODR_OD5; //ENCENDIENDO LED    


}

void init_tim3(){
    RCC->APB1ENR &= ~RCC_APB1ENR_TIM3EN; //HABILITANDO RELOJ PARA TIM3
    RCC->APB1RSTR |= RCC_APB1RSTR_TIM3RST; //REINICIANDO TIM3
    
    TIM3->CNT = 0; //REINICIANDO CONTADOR
    TIM3->PSC = (16000-1); //CONFIGURANDO PRESCALER
    TIM3->ARR = (2500-1); //CONFIGURANDO VALOR DE ARR


    TIM3->CR1 &= ~(0x3 << TIM_CR1_CEN_Pos); //HABILITANDO CONTADOR
    TIM3->CR1 &= ~(TIM_CR1_ARPE); //HABILITANDO
    TIM3->CR1 |= (TIM_CR1_ARPE); //HABILITANDO CONTADOR
    TIM3->CR1 |= ~(TIM_CR1_DIR);

    //ACTIVANDO INTERRUPCION DE DESBORDAMIENTO
    TIM3->DIER |= TIM_DIER_UIE; //HABILITANDO INTERRUP
    //CONFIGURANDO EL NVIC 
    NVIC_EnableIRQ(TIM3_IRQn); //ACTIVAMOS LA INTERRUPCION DE TIM3 EN EL NVIC

    TIM3->CR1 |= TIM_CR1_CEN; //HABILITANDO CONTADOR    
}


//RUTINA DE ATIONCION A LA INTERRUPCION DE TIM3
//EL JOMBRE DE ESTA FUNCION SE TOMA DEL VECTOR DE INTERRUPCIONES DEL MICROCONTROLADOR
//UBICADO EN EL ARCHIVO startup_stm32f4xx.s
void TIM3_IRQHandler(void){
    //PRIMERO VERIFICAMOS QUE LA BANDERA DE LA INTERRUPCION ESTE ACTIVA, YA QUE EL NVIC PUEDE ESTAR CONFIGURADO PARA VARIAS INTERRUPCIONES
    if(TIM3->SR && TIM_SR_UIF){ //VERIFICANDO SI LA INTERRUPCION FUE POR DESBORDAMIENTO Y ESTÁ LEVANTADA
        TIM3->SR &= ~TIM_SR_UIF; //LIMPIANDO BANDERA DE INTERRUPCION
        GPIOA->ODR ^= GPIO_ODR_OD5; //CAMBIANDO ESTADO DEL LED
    }
}
